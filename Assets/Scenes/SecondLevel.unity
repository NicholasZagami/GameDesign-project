  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "E cos\xEC, l\u2019eco dei rituali si spegne nelle cripte dell\u2019Abbazia
    Nera.\r\nIl Cuore delle Tenebre non arde pi\xF9 tra le mani dei folli che tentarono
    di evocare il Demone Sommo.\r\n\r\nMa i sigilli sono incrinati\u2026 e l\u2019Occhio
    del Caos ha intravisto uno spiraglio sul nostro mondo.\r\n\r\nLe voci dei custodi
    caduti sussurrano che l\u2019equilibrio \xE8 fragile, e che il tempo concesso
    non \xE8 eterno.\r\n\r\nOggi hai ricacciato l\u2019oscurit\xE0.\r\nDomani, qualcuno
    dovr\xE0 affrontarne il ritorno."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: aca7c653f293d21478c9743cc459ea51, type: 2}
